# Large files: excluded from git, hashed in MANIFEST.sha256, the irreplaceable ones published as a GitHub Release.
audio/track/
audio/stems/
audio/master/
renders/
takes/
reference/stills/
*.wav
*.mp3
*.flac
*.zip
*.blend
*.blend1
*.mp4
*.mov
*.mkv
*.webm
transcripts/

# Reference material: never published, never hashed into the manifest.
reference/inspiration/

# Regenerable: never archived; versions and regen commands are logged instead.
frames/
**/frames/
cache/
**/__pycache__/
.venv/
venv/
node_modules/
models/
*.pt
*.safetensors

# Other publishers' pages saved as fact-check evidence (the human retrieved them, R4): kept locally, never published;
# reference/sources/*.tsv (in git) lists each one's URL and hash.
reference/sources/*/

# The upload-ready videos (large; listed in MANIFEST.sha256). The SRTs and thumbnail are small and kept in git.
deliverables/*.mp4

# The N33 screen capture: Anthropic's page, not ours to publish (human, 2026-10-26). Kept locally only; its URL and
# capture time are in the sidecar JSON (in git), and scripts/capture_page.mjs recaptures it.
assets/screens/*.png
